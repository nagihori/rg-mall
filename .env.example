DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for migrations/backup only. Never set this on Vercel.
DATABASE_ADMIN_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ローカル開発専用。VercelのBLOB_READ_WRITE_TOKENとは別のBlobストアのトークンを使う(Vercelダッシュボード > Storage > 対象Blobストア > .env.local タブで取得)
BLOB_LOCAL_STORE_ID=
BLOB_LOCAL_READ_WRITE_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_REVIEW_WEBHOOK_URL=
