DATABASE_URL=postgresql://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for migrations/backup only. Never set this on Vercel.
DATABASE_ADMIN_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ローカル開発専用。VercelのBLOB_READ_WRITE_TOKENとは別のBlobストアのトークンを使う(Vercelダッシュボード > Storage > 対象Blobストア > .env.local タブで取得)
BLOB_LOCAL_STORE_ID=
BLOB_LOCAL_READ_WRITE_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_REVIEW_WEBHOOK_URL=
# 確認依頼通知でメンションするDiscordロールID(省略可。サーバー設定 > ロール > 対象ロールの「IDをコピー」)
DISCORD_REVIEWER_ROLE_ID=
# 開催終了イベントの自動アーカイブ(Vercel Cron)を叩く際の認証トークン。Vercel側で設定すると
# Cron実行時にAuthorization: Bearer <値> が自動付与される。ローカルではcurlでテストする時だけ使う
CRON_SECRET=
# Vercel Blobストレージ使用量監視(Vercel Cron)用。Vercelダッシュボード > Account Settings >
# Tokens で発行するPersonal Access Token(読み取り権限で可)と、対象チームのID(vercel teams ls 等で確認)
VERCEL_PERSONAL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
# Blob Storageの無料枠(GB)。省略時は1GBとして計算する。Vercelが枠を変更した場合はここを上書きする
VERCEL_BLOB_STORAGE_LIMIT_GB=
# Discord Botのスラッシュコマンド(/tccheck)用。Discord Developer Portal > Bot でトークンを発行、
# General Information の Public Key を控える。Application IDはDISCORD_CLIENT_IDと同一のものを使う。
# デプロイ後、Discord Developer Portal > General Information > Interactions Endpoint URL に
# https://<本番URL>/api/discord/interactions を設定する(登録時に自動でPING検証が飛ぶ)。
# コマンド自体の登録は npm run discord:register-commands で一度だけ実行する
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
